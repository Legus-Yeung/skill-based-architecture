# ---------------------------------------------------------------------------
# Tokenized infrastructure abstractions
# ---------------------------------------------------------------------------
# These are INTERFACE TOKENS, not live connection strings. In this PoC the
# mock tool layer binds each token to an in-memory simulator and logs the
# intended read/write. In production, swap the mock clients for real drivers
# without changing skill YAML or the orchestrator.
#
# Bind these tokens to real systems when you leave mock mode, e.g.:
#   POSTGRES_DATABASE_1=postgresql://user:pass@orders-primary:5432/ecommerce
#   STRIPE_PAYMENT_GATEWAY_1=https://api.stripe.com/v1
#   ZENDESK_API_1=https://acme.zendesk.com/api/v2
# ---------------------------------------------------------------------------

# System of record — customer profiles, orders, tracking
POSTGRES_DATABASE_1=mock://postgres-primary.internal:5432/ecommerce

# Secondary CRM replica (bound later; declared so the surface is complete)
CRM_DB_2=mock://crm-replica.internal:5432/crm

# Payments — refunds never mutate Postgres; they go through the gateway
STRIPE_PAYMENT_GATEWAY_1=mock://stripe-gateway.internal/v1
STRIPE_GATEWAY_URL=mock://stripe-gateway.internal/v1

# Case management — human escalation / high-value claims
ZENDESK_API_1=mock://zendesk.internal/api/v2
ZENDESK_API_TOKEN=tok_zendesk_mock_not_a_real_secret

# Gemini — skill router + tool-calling agent (required for demo.py)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
